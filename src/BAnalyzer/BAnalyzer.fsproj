<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <DevelopmentDependency>true</DevelopmentDependency>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>BAnalyzer</PackageId>
    <Version>1.0.0</Version>
    <Description>Roslyn analyzers and code fixes for Visual Studio and VS Code. Install this package on a C# project to get editor squiggles, the Problems/Error List, and light-bulb fixes.</Description>
    <PackageTags>roslyn;analyzer;analyzers;codefix;diagnostics</PackageTags>
    <NoWarn>$(NoWarn);NU5128;FS2003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Rules.fs" />
    <Compile Include="DateTimeNowAnalyzer.fs" />
    <Compile Include="DateTimeNowCodeFix.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="FSharp.Core" GeneratePathProperty="true" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.8.0" PrivateAssets="all" />
    <PackageReference Include="System.Composition" Version="8.0.0" PrivateAssets="all" />
  </ItemGroup>

  <!--
    NuGet convention for both Visual Studio and VS Code C# Dev Kit:
    put the analyzer and its FSharp.Core dependency under analyzers/dotnet/cs,
    not in lib/. The IDE host loads those DLLs as analyzers; they are not
    referenced by the consuming project at runtime.
  -->
  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);PackAnalyzerAssemblies</TargetsForTfmSpecificContentInPackage>
    <GetTargetPathDependsOn>$(GetTargetPathDependsOn);AddAnalyzerDependencies</GetTargetPathDependsOn>
  </PropertyGroup>

  <Target Name="PackAnalyzerAssemblies">
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(TargetPath)" PackagePath="analyzers/dotnet/cs" />
      <TfmSpecificPackageFile Include="$(PkgFSharp_Core)\lib\netstandard2.0\FSharp.Core.dll" PackagePath="analyzers/dotnet/cs" />
    </ItemGroup>
  </Target>

  <Target Name="AddAnalyzerDependencies">
    <ItemGroup>
      <TargetPathWithTargetPlatformMoniker Include="$(PkgFSharp_Core)\lib\netstandard2.0\FSharp.Core.dll" IncludeRuntimeDependency="false" />
    </ItemGroup>
  </Target>
</Project>
